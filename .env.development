# 开发环境配置

# API 基础 URL（当 Mock 关闭时使用）
# 如果没有真实后端，请保持 Mock 开启（VUE_APP_MOCK=true）
VUE_APP_API_BASE_URL=http://localhost:8000

# WebSocket URL
VUE_APP_WS_URL=ws://localhost:8000

# 是否启用 Mock（默认开启，前端可独立运行）
VUE_APP_MOCK=true

# 应用标题
VUE_APP_TITLE=拉曼光谱智能检测系统

# 应用版本
VUE_APP_VERSION=2.0.0

# 开发服务器端口
PORT=8080

# 是否开启代理
OPEN_PROXY=true

# Mock 配置
VUE_APP_MOCK_DELAY=300
VUE_APP_MOCK_ERROR_RATE=0

